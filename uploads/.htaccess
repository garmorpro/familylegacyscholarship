# Uploaded files are user-provided data, never code.
# Block execution of any script type regardless of extension, even if one
# somehow ends up in this directory tree.
<FilesMatch "\.(php|php\d|phtml|pht|phar|cgi|pl|py|sh|exe)$">
    Require all denied
</FilesMatch>

<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

Options -ExecCGI
AddHandler cgi-script .php .php3 .php4 .php5 .php7 .phtml .pl .py .cgi .sh
